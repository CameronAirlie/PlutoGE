{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PlutoGE: Electron Editor",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\tools\\Start-ElectronEditor.ps1\"",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "PlutoGE: Electron Editor (Fast)",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\tools\\Start-ElectronEditor.ps1\" -SkipNativeBuild -SkipInstall",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "PlutoGE: Package Electron Editor",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\tools\\Package-ElectronEditor.ps1\"",
            "cwd": "${workspaceFolder}"
        }
    ]
}