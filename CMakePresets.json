{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "PLUTO_BUILD_EDITOR": "ON",
                "PLUTO_BUILD_RUNTIME": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Unix Makefiles",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "inherits": "base",
            "architecture": "x64",
            "toolset": "host=x64",
            "cacheVariables": {
                "PLUTO_ENABLE_STREAMLINE": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc17",
            "displayName": "Visual Studio 17 2022 (x64)",
            "inherits": "msvc-base",
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "msvc18",
            "displayName": "Visual Studio 18 2026 (x64)",
            "inherits": "msvc-base",
            "generator": "Visual Studio 18 2026"
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "configurePreset": "linux-release"
        },
        {
            "name": "msvc17-debug",
            "displayName": "Visual Studio 17 2022 Debug",
            "configurePreset": "msvc17",
            "configuration": "Debug"
        },
        {
            "name": "msvc17-release",
            "displayName": "Visual Studio 17 2022 Release",
            "configurePreset": "msvc17",
            "configuration": "Release"
        },
        {
            "name": "msvc18-debug",
            "displayName": "Visual Studio 18 2026 Debug",
            "configurePreset": "msvc18",
            "configuration": "Debug"
        },
        {
            "name": "msvc18-release",
            "displayName": "Visual Studio 18 2026 Release",
            "configurePreset": "msvc18",
            "configuration": "Release"
        }
    ]
}
