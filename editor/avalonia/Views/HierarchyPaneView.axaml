<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PlutoGE.Editor.Avalonia.ViewModels"
             x:Class="PlutoGE.Editor.Avalonia.Views.HierarchyPaneView"
             x:DataType="vm:HierarchyPaneViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="9">
    <TextBlock FontSize="10" Margin="1,0,0,7" Foreground="{DynamicResource EditorMutedTextBrush}"
               Text="{Binding Session.ActiveScene}" />
    <TextBox Grid.Row="1" Classes="editor-search" Margin="0,0,0,7"
             PlaceholderText="Search scene…" Text="{Binding Session.SearchText, Mode=TwoWay}" />
    <TreeView Grid.Row="2" Classes="editor-tree" ItemsSource="{Binding Session.Hierarchy}"
              SelectedItem="{Binding Session.SelectedEntity, Mode=TwoWay}">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="vm:EntityNodeViewModel" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="17" Height="17" CornerRadius="5" Background="{DynamicResource EditorAccentMutedBrush}">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource EditorAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
  </Grid>
</UserControl>
