<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlutoGE.Editor.Avalonia.ViewModels"
        x:Class="PlutoGE.Editor.Avalonia.Windows.FloatingPaneWindow"
        x:DataType="vm:DockPaneViewModel"
        Width="760" Height="560" MinWidth="320" MinHeight="240">
  <Grid RowDefinitions="38,*">
    <Border Background="{DynamicResource EditorRaisedBrush}"
            BorderBrush="{DynamicResource EditorBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" Margin="10,5">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
          <Button Content="Dock" Command="{Binding DockCommand}" />
          <Button Classes="dock-action" Content="×" Command="{Binding CloseCommand}" ToolTip.Tip="Close pane" />
        </StackPanel>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding Content}" />
  </Grid>
</Window>
