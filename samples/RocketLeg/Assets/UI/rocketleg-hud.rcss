@font-face {
    font-family: RocketLegFont;
    src: url("../../../../editor/resources/fonts/MartianMono-StdRg.ttf");
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f5f8ff;
    font-family: RocketLegFont;
    pointer-events: none;
    background-color: transparent;
}

#rocketleg-hud {
    width: 100%;
    height: 100%;
}

#scoreboard {
    position: absolute;
    top: 24px;
    left: 50%;
    margin-left: -330px;
    width: 660px;
    padding: 13px 20px 15px 20px;
    text-align: center;
    font-size: 27px;
    background-color: #07111ccc;
    border: 2px #ffffff50;
}

.blue-team { color: #49b9ff; }
.orange-team { color: #ff9a3d; }

.score {
    margin-left: 23px;
    margin-right: 23px;
    color: #ffffff;
    font-size: 38px;
    font-weight: bold;
}

.separator { color: #8d9bab; }

#match-status {
    position: absolute;
    top: 43%;
    left: 20%;
    right: 20%;
    padding: 10px;
    text-align: center;
    color: #ffe078;
    font-size: 38px;
    font-weight: bold;
    text-shadow: 2px 2px #000000;
}

#controls {
    position: absolute;
    left: 24px;
    bottom: 22px;
    padding: 11px 15px;
    color: #dbe5ef;
    font-size: 13px;
    line-height: 20px;
    background-color: #07111ccc;
    border: 1px #ffffff45;
}

.camera-help {
    color: #92a6ba;
    text-align: center;
}

#game-title {
    position: absolute;
    right: 24px;
    bottom: 280px;
    color: #ffffffa0;
    font-size: 20px;
    letter-spacing: 4px;
}

#boost-gauge {
    position: absolute;
    right: 28px;
    bottom: 28px;
    width: 190px;
    padding: 18px;
    border: 3px #49b9ff;
    border-radius: 36px;
    background-color: #07111ce6;
    text-align: center;
    color: #ffd369;
}
#boost-player { font-size: 13px; color: #49b9ff; }
#boost-value { font-size: 64px; line-height: 74px; }
#boost-label { font-size: 17px; letter-spacing: 3px; }
#boost-track { height: 12px; margin-top: 14px; background-color: #ffffff25; }
#boost-fill { width: 100%; height: 100%; background-color: #ffc34a; }
#boost-help { margin-top: 10px; font-size: 11px; color: #b4c0ce; }
#boost-gauge.orange { border-color: #ff9a3d; }
#boost-gauge.orange #boost-player { color: #ff9a3d; }
#boost-gauge.boosting { background-color: #543a16e6; }
#boost-gauge.empty { color: #8995a5; }

#flip-status { margin-top: 10px; font-size: 12px; color: #a8cde8; }
