@font-face {
    font-family: RocketLegFont;
    src: url("../../../../editor/resources/fonts/MartianMono-StdRg.ttf");
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    color: #f5f8ff;
    font-family: RocketLegFont;
    pointer-events: none;
    background-color: transparent;
}

#rocketleg-hud {
    width: 100%;
    height: 100%;
}

#scoreboard {
    position: absolute;
    top: 24px;
    left: 50%;
    margin-left: -330px;
    width: 660px;
    padding: 13px 20px 15px 20px;
    text-align: center;
    font-size: 27px;
    background-color: #07111ccc;
    border: 2px #ffffff50;
}

.blue-team { color: #49b9ff; }
.orange-team { color: #ff9a3d; }

.score {
    margin-left: 23px;
    margin-right: 23px;
    color: #ffffff;
    font-size: 38px;
    font-weight: bold;
}

.separator { color: #8d9bab; }

#match-status {
    position: absolute;
    top: 43%;
    left: 20%;
    right: 20%;
    padding: 10px;
    text-align: center;
    color: #ffe078;
    font-size: 38px;
    font-weight: bold;
    text-shadow: 2px 2px #000000;
}

#controls {
    position: absolute;
    left: 24px;
    bottom: 22px;
    padding: 11px 15px;
    color: #dbe5ef;
    font-size: 13px;
    line-height: 20px;
    background-color: #07111ccc;
    border: 1px #ffffff45;
}

.camera-help {
    color: #92a6ba;
    text-align: center;
}

#game-title {
    position: absolute;
    right: 24px;
    bottom: 22px;
    color: #ffffffa0;
    font-size: 20px;
    letter-spacing: 4px;
}
