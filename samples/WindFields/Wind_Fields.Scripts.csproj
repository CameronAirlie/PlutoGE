<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by the PlutoGE editor; safe to commit. Put your own settings and package references in
       $(MSBuildProjectName).custom.props or .custom.targets, which the editor never changes. -->
  <Import Project="$(MSBuildProjectName).engine.props" Condition="Exists('$(MSBuildProjectName).engine.props')" />
  <Import Project="$(MSBuildProjectName).custom.props" Condition="Exists('$(MSBuildProjectName).custom.props')" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>Wind_Fields.Scripts</AssemblyName>
    <RootNamespace>Wind_Fields.Scripts</RootNamespace>
    <OutputPath>Assets/Managed/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Assets/Scripts/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlutoGEScriptCoreIsProject)' == 'true'">
    <ProjectReference Include="$(PlutoGEScriptCore)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlutoGEScriptCoreIsProject)' != 'true'">
    <Reference Include="PlutoGE.ScriptCore">
      <HintPath>$(PlutoGEScriptCore)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyScriptCoreRuntimeFiles" AfterTargets="Build">
    <PropertyGroup>
      <_PlutoGERuntimeFiles Condition="'$(PlutoGEScriptCoreIsProject)' == 'true'">$(PlutoGEScriptCoreRuntime)/bin/$(Configuration)/$(TargetFramework)</_PlutoGERuntimeFiles>
      <_PlutoGERuntimeFiles Condition="'$(PlutoGEScriptCoreIsProject)' != 'true'">$(PlutoGEScriptCoreRuntime)</_PlutoGERuntimeFiles>
    </PropertyGroup>
    <ItemGroup>
      <ScriptCoreRuntimeFiles Include="$(_PlutoGERuntimeFiles)/PlutoGE.ScriptCore.runtimeconfig.json" />
      <ScriptCoreRuntimeFiles Include="$(_PlutoGERuntimeFiles)/PlutoGE.ScriptCore.deps.json" Condition="Exists('$(_PlutoGERuntimeFiles)/PlutoGE.ScriptCore.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(ScriptCoreRuntimeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="@(ScriptCoreRuntimeFiles) != ''" />
  </Target>
  <Import Project="$(MSBuildProjectName).custom.targets" Condition="Exists('$(MSBuildProjectName).custom.targets')" />
</Project>
